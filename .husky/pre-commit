ROOT=$(git rev-parse --show-toplevel)

# Run shellcheck on staged shell scripts
STAGED_SH=$(git -C "$ROOT" diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)
if [ -n "$STAGED_SH" ]; then
  SHELLCHECK=$(command -v shellcheck 2>/dev/null || true)
  if [ -z "$SHELLCHECK" ]; then
    echo "warning: shellcheck not found — skipping shell script checks (install with: sudo apt-get install shellcheck)"
  else
    echo "$STAGED_SH" | sed "s|^|$ROOT/|" | xargs "$SHELLCHECK"
  fi
fi

cd "$ROOT/frontend" && npx lint-staged

# Run ruff and mypy on staged backend Python files
STAGED_PY=$(git -C "$ROOT" diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$' || true)
if [ -n "$STAGED_PY" ]; then
  RUFF=$(command -v ruff 2>/dev/null || echo "$ROOT/backend/.venv/bin/ruff")
  MYPY=$(command -v mypy 2>/dev/null || echo "$ROOT/backend/.venv/bin/mypy")
  BANDIT=$(command -v bandit 2>/dev/null || echo "$ROOT/backend/.venv/bin/bandit")
  if [ ! -x "$RUFF" ]; then
    echo "error: ruff not found (checked PATH and $ROOT/backend/.venv/bin/ruff)"
    exit 1
  fi
  if [ ! -x "$MYPY" ]; then
    echo "error: mypy not found (checked PATH and $ROOT/backend/.venv/bin/mypy)"
    exit 1
  fi
  if [ ! -x "$BANDIT" ]; then
    echo "error: bandit not found (checked PATH and $ROOT/backend/.venv/bin/bandit)"
    exit 1
  fi
  STAGED_ABS=$(echo "$STAGED_PY" | sed "s|^|$ROOT/|")
  echo "$STAGED_ABS" | xargs "$RUFF" format --check
  echo "$STAGED_ABS" | xargs "$RUFF" check
  cd "$ROOT/backend" && "$MYPY" app/
  echo "$STAGED_ABS" | xargs "$BANDIT" -ll
fi
