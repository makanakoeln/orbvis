{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    // cmk-frontend-vue does not enable exactOptionalPropertyTypes; its
    // sources (compiled here, e.g. cva-based variant props) fail under
    // it. The external OrbVis repo keeps the stricter flag.
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      // OrbVis sources first; the fallback lets '@/...' imports INSIDE
      // cmk-frontend-vue files (their own-src convention) type-check.
      // The two trees do not overlap, so the fallback is unambiguous.
      "@/*": ["./src/*", "../cmk-frontend-vue/src/*"],
      "@cmk/*": ["../cmk-frontend-vue/src/*"]
    },
    "types": ["vite/client", "vitest/globals"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
