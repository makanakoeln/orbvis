{
  "name": "demo-static",
  "alias": "Static Board (Demo)",
  "readonly": true,
  "backend_id": "test",
  "icon_size": 28,
  "rotation_interval": 0,
  "hover_template": "{{name}}\nState: {{state}}\n{{output}}",
  "context_template": null,
  "background_image": "demo.svg",
  "view": { "type": "static" },
  "objects": [
    {
      "id": "host-localhost",
      "type": "host",
      "x": 270,
      "y": 190,
      "z": 1,
      "host_name": "localhost",
      "label": { "show": true, "text": "localhost", "x": 0, "y": 34, "size": 11, "color": "#ffffff", "background": "transparent" },
      "display": { "mode": "icon" }
    },
    {
      "id": "host-router01",
      "type": "host",
      "x": 570,
      "y": 190,
      "z": 1,
      "host_name": "router01",
      "label": { "show": true, "text": "router01", "x": 0, "y": 34, "size": 11, "color": "#ffffff", "background": "transparent" },
      "display": { "mode": "icon" }
    },
    {
      "id": "host-fileserver",
      "type": "host",
      "x": 420,
      "y": 380,
      "z": 1,
