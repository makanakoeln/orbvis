      "type": "service",
      "x": 760,
      "y": 355,
      "z": 1,
      "host_name": "localhost",
      "service_description": "CPU Load",
      "label": { "show": true, "text": "CPU Load", "x": 0, "y": 56, "size": 10, "color": "#ffffff", "background": "transparent" },
      "display": { "mode": "gadget", "gadget_type": "gauge" }
