      "id": "shape-logo",
      "type": "image",
      "x": 1265,
      "y": 190,
      "z": 1,
      "label": { "show": true, "text": "image", "x": 0, "y": 34, "size": 10, "color": "#ffffff", "background": "transparent" }
    },
    {
      "id": "map-self",
      "type": "map",
      "x": 1265,
      "y": 380,
      "z": 1,
      "map_name": "demo-radar",
      "label": { "show": true, "text": "map \u2192 Radar", "x": 0, "y": 34, "size": 10, "color": "#ffffff", "background": "transparent" },
