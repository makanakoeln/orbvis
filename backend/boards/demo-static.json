      "x": 760,
      "y": 190,
      "z": 1,
      "host_name": "localhost",
      "service_description": "HTTP",
      "label": { "show": true, "text": null, "x": 0, "y": 34, "size": 10, "color": "#ffffff", "background": "transparent" },
      "display": { "mode": "icon" }
    },
    {
      "id": "svc-ping",
