{
  "name": "orbvis-frontend",
  "version": "2.0.0",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint 'src/**/*.{css,vue}'",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "format": "prettier --write 'src/**/*.{ts,vue,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css}'",
    "deploy:cmc": "VITE_BASE_PATH=/CMC/orbvis/ npm run build && sudo /home/ronny/git/orbvis/deploy-cmc.sh",
    "copy-builtin-icons": "node scripts/copy-builtin-icons.js"
  },
  "dependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/sanitize-html": "^2.16.1",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.1",
    "echarts": "^5.6.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.6",
    "sanitize-html": "^2.17.3",
    "vue": "^3.5.31",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tabler/icons": "^3.41.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.99.0",
    "stylelint": "^17.5.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^6.4.2",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
