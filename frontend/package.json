{
  "name": "orbvis-frontend",
  "version": "0.6.0",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:standalone": "VITE_BUILD_TARGET=standalone vite",
    "dev:cmk-source": "CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vite",
    "build": "vue-tsc && npm run i18n:compile && vite build",
    "build:standalone": "VITE_BUILD_TARGET=standalone vue-tsc && VITE_BUILD_TARGET=standalone vite build",
    "build:cmk-source": "CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vue-tsc && CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vite build",
    "preview": "vite preview",
    "drift-check": "../scripts/sync-cmk-vendor.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint 'src/**/*.{css,vue}'",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "format": "prettier --write 'src/**/*.{ts,vue,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css}'",
    "copy-builtin-icons": "node scripts/copy-builtin-icons.js",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:ui": "playwright test --ui",
    "i18n:extract": "vue-gettext-extract",
    "i18n:compile": "vue-gettext-compile > /dev/null && node scripts/sort-locale-json.js"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/sanitize-html": "^2.16.2",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "sanitize-html": "^2.18.1",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0",
    "vue3-gettext": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tabler/icons": "^3.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.14",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.0",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.5",
    "vitest-fail-on-console": "^0.10.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
