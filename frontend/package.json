{
  "name": "orbvis-frontend",
  "version": "0.6.0",
  "private": true,
  "license": "GPL-2.0-only",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:standalone": "VITE_BUILD_TARGET=standalone vite",
    "dev:cmk-source": "CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vite",
    "build": "vue-tsc && npm run i18n:compile && vite build",
    "build:standalone": "VITE_BUILD_TARGET=standalone vue-tsc && VITE_BUILD_TARGET=standalone vite build",
    "build:cmk-source": "CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vue-tsc && CMK_FRONTEND_VUE_SRC=${CMK_FRONTEND_VUE_SRC:-$HOME/git/checkmk/packages/cmk-frontend-vue/src} vite build",
    "preview": "vite preview",
    "drift-check": "../scripts/sync-cmk-vendor.sh",
    "drift-check:upstream": "../scripts/sync-upstream-frontend.sh --check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . && stylelint 'src/**/*.{css,vue}'",
    "lint:css": "stylelint 'src/**/*.{css,vue}'",
    "format": "prettier --write 'src/**/*.{ts,vue,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,vue,css}'",
    "copy-builtin-icons": "node scripts/copy-builtin-icons.js",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:ui": "playwright test --ui",
    "i18n:extract": "vue-gettext-extract",
    "i18n:compile": "vue-gettext-compile > /dev/null && node scripts/sort-locale-json.js"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/sanitize-html": "^2.16.1",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "class-variance-authority": "^0.7.1",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.8",
    "sanitize-html": "^2.17.4",
    "vue": "^3.5.31",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.4",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@tabler/icons": "^3.44.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/d3": "^7.4.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.14",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.3.2"
  }
}
